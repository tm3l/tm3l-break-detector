# Stage 1: Build Rust Engine
FROM rust:alpine AS rust-builder
RUN apk add --no-cache musl-dev
WORKDIR /app/engine
COPY engine/Cargo.toml ./
COPY engine/src ./src
RUN cargo build --release

# Stage 2: Build Go Server
FROM golang:1.23-alpine AS go-builder
WORKDIR /app/server
COPY server/go.mod server/go.sum* ./
RUN go mod download
COPY server/ ./
RUN go build -o bin/server cmd/server/main.go

# Stage 3: Final Alpine Image
FROM alpine:latest
WORKDIR /app
COPY --from=rust-builder /app/engine/target/release/break-detector-engine .
COPY --from=go-builder /app/server/bin/server .
EXPOSE 8080
CMD ["./server"]
