FROM rust:alpine AS rust-builder
RUN apk add --no-cache build-base clang compiler-rt protobuf-dev
WORKDIR /app
COPY proto ./proto
WORKDIR /app/engine
COPY engine/Cargo.toml engine/build.rs ./
COPY engine/src ./src
RUN RUSTFLAGS="-C link-arg=-lgcc" cargo build --release

FROM alpine:latest
RUN apk add --no-cache libgcc
WORKDIR /app
COPY --from=rust-builder /app/engine/target/release/break-detector-engine .
EXPOSE 50051
CMD ["./break-detector-engine"]
